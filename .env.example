# RPC for deploy / upgrade / verify scripts (BSC mainnet, chain id 56)
RPC_URL=https://bsc-dataseed.bnbchain.org
# Deployer key
PRIVATE_KEY=
# BscScan API key (bscscan.com/myapikey) for verify:bsc; optional
BSCSCAN_API_KEY=
# Pyth contract on the target chain (BSC mainnet 0x4D7E825f80bDf85e913E0DD2A2D54927e9dE1594, BSC testnet 0x5744Cbf430D99456a0A8771208b674F27f8EF0Fb)
PYTH_ADDRESS=0x4D7E825f80bDf85e913E0DD2A2D54927e9dE1594
# Collateral token: USDT on BSC mainnet; leave empty to deploy MockUSDT
USDT_ADDRESS=0x55d398326f99059fF775485246999027B3197955
# Backend address allowed to execute signed orders; defaults to the deployer
EXECUTOR_ADDRESS=
