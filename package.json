{
  "name": "contracts",
  "private": true,
  "scripts": {
    "build": "forge build",
    "test": "forge test",
    "deploy:local": "forge script script/Deploy.s.sol --rpc-url http://127.0.0.1:8545 --broadcast --private-key 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80",
    "deploy:bsc": "set -a && . ../.env && set +a && forge script script/Deploy.s.sol --rpc-url $RPC_URL --broadcast --private-key $PRIVATE_KEY",
    "deploy:multicall:local": "forge script script/DeployMulticall.s.sol --rpc-url http://127.0.0.1:8545 --broadcast --private-key 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80",
    "deploy:multicall:bsc": "set -a && . ../.env && set +a && forge script script/DeployMulticall.s.sol --rpc-url $RPC_URL --broadcast --private-key $PRIVATE_KEY",
    "verify:bsc": "set -a && . ../.env && set +a && forge script script/Deploy.s.sol --rpc-url $RPC_URL --resume --verify --etherscan-api-key $BSCSCAN_API_KEY"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.1.0",
    "@openzeppelin/contracts-upgradeable": "5.6.1",
    "@pythnetwork/pyth-sdk-solidity": "^4.3.1"
  }
}
